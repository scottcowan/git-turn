#!/usr/bin/env node
'use strict';

const { execFileSync } = require('child_process');
const path = require('path');
const fs = require('fs');

const COMMANDS = ['init', 'log', 'show', 'diff', 'blame', 'bisect', 'heatmap', 'revert', 'redo', 'branch', 'status', 'gc', 'session', 'cost', 'export', 'record-prompt', 'redact', 'mcp'];

const [,, cmd, ...args] = process.argv;

if (!cmd || cmd === '--help' || cmd === '-h') {
  console.log(`git turn <command> [options]

Commands:
  init                    Install post-commit hook in current repo
  log [--with-prompts] [--no-cache] [--json]
                          List all turns in current session
  show <N> [--with-prompts] [--plain] [--json]
                          Full diff for turn N (with prompt if available)
  diff <N> [M] [--plain] [--json]
                          Diff turn N-1 vs N, or N vs M
  blame <file> [--no-cache] [--json]  Which turn last touched each line
  bisect <cmd> [--no-cache]  Find the first turn where <cmd> fails
  heatmap [--no-cache]       Calendar heatmap of turn activity across all sessions
  revert <N>              Restore worktree to turn N state
  redo                    Undo the last revert
  branch --from <N>       New worktree from turn N snapshot
  status                  Current session, turn count, hook health
  gc [--keep-sessions N]  Prune old session refs
  gc --purge-notes       Permanently purge old note blobs from refs/notes/git-turn (see redact)
  session new|list        Manage sessions
  cost [--all] [--json]   Show token usage and cost for current session
  record-prompt           Attach prompt/model/usage/latency metadata to the latest turn (JSON on stdin)
  redact <N>              Scrub a turn's captured prompt after the fact
  export [--since <ref>] [--output <path>]  Bundle git-turn refs for handoff to another repo
  mcp                     Start a stdio MCP server scoped to the current repo
`);
  process.exit(0);
}

if (!COMMANDS.includes(cmd)) {
  console.error(`git turn: unknown command '${cmd}'\nRun 'git turn --help' for usage.`);
  process.exit(1);
}

// Resolve command module
const cmdPath = path.join(__dirname, '..', 'src', 'commands', `${cmd}.js`);
if (!fs.existsSync(cmdPath)) {
  console.error(`git turn: command '${cmd}' not yet implemented`);
  process.exit(1);
}

const result = require(cmdPath).run(args);
if (result && typeof result.then === 'function') {
  result.catch(err => { console.error(`git turn: ${err.message}`); process.exit(1); });
}
